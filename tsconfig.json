{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "declaration": true,
    "sourceMap": false,
    "rootDir": "src",
    "skipLibCheck": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "outDir": "dist/esm"
  },
  "include": ["src"]
}
